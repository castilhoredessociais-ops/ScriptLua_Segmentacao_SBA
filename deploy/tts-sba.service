[Unit]
Description=TTS dedicado - Segmentacao SBA (Standard Bank Angola)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/gcloud-tts-api

Environment="GOOGLE_APPLICATION_CREDENTIALS=/opt/APIs_keys/sba-segment-ucallkey.json"

ExecStart=/opt/tts-venv/bin/python3 /opt/gcloud-tts-api/tts_sba.py

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
